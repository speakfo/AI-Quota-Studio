// Copy to Local.xcconfig (ignored by git) and fill in your values.

// Reverse-DNS prefix for bundle identifiers, e.g. com.yourname.
BUNDLE_ID_PREFIX = com.yourname

// Optional: sign with your Apple Development certificate instead of ad-hoc.
// macOS then keeps privacy permissions across rebuilds instead of asking again.
// Team ID: Xcode → Settings → Accounts.
// DEVELOPMENT_TEAM = ABCDE12345
// CODE_SIGN_STYLE = Automatic
// CODE_SIGN_IDENTITY = Apple Development
